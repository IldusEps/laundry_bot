# Автозапуск бота на Linux-сервере (systemd).
# 1) Скопируйте проект в /opt/laundry_bot и создайте venv (см. README)
# 2) sudo cp laundry-bot.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now laundry-bot

[Unit]
Description=Telegram bot: запись на стирку в общежитии
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=laundry
WorkingDirectory=/opt/laundry_bot
ExecStart=/opt/laundry_bot/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
