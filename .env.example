# Один файл .env на оба бота: Telegram (main.py) и ВКонтакте (vk_main.py). База MySQL у них общая.
# Токен «чужого» мессенджера тоже нужен каждому боту — через него уходят уведомления жильцам
# из другого мессенджера. Если токен пуст, бот работает, а уведомления туда пропускаются.

# ==== Telegram ====
# Токен от @BotFather. Пусто — Telegram-бот не запускается, уведомления в Telegram не отправляются
BOT_TOKEN=1234567890:AAAA_замените_на_свой_токен
# telegram_id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=123456789

# ==== ВКонтакте ====
# Ключ доступа сообщества: Управление → Дополнительно → Работа с API → Ключи доступа
# (права: сообщения сообщества, фотографии, документы). Пусто — VK-бот не запускается,
# уведомления в VK не отправляются
VK_TOKEN=
# id сообщества — число (видно в адресе vk.com/club123456 или в «Работа с API»)
VK_GROUP_ID=
# id администраторов в VK через запятую — числа, не короткое имя страницы.
# Узнать свой id: напишите запущенному боту слово «id»
VK_ADMIN_IDS=

# ==== MySQL ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=laundry_bot
DB_PASSWORD=change_me
DB_NAME=laundry_bot

# ==== Время ====
TIMEZONE=Europe/Samara
# Открытие записи на новую неделю: этажи 2–3 — понедельник, 4 и 5 этажи — воскресенье
WEEK_OPEN_TIME=15:00
FLOOR4_WEEK_OPEN_TIME=15:00
FLOOR5_WEEK_OPEN_TIME=15:00

# ==== Общежитие ====
# Последний этаж (1 этаж не записывается)
MAX_FLOOR=5
# Максимальный номер комнаты на этаже (для 5 этажа всегда 501–536)
MAX_ROOM_ON_FLOOR=36
# Этажи со своим максимумом (этаж:номер через запятую): на 3 этаже вместо 336 есть 323а
FLOOR_MAX_ROOMS=3:35
# Комнаты с буквой, которые существуют (через запятую)
LETTER_ROOMS=323а

# ==== Прокси для Telegram ====
# socks5h — DNS тоже через прокси. Пример: socks5h://user:password@127.0.0.1:1080
# Пусто — подключение напрямую
PROXY_URL=

# ==== Логи ====
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_MB=10
LOG_BACKUP_COUNT=10
